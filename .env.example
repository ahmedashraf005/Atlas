# Neon Postgres connection string (used from segment 2)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# 32+ random characters, used to sign the demo session cookie (segment 2)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local persisted Postgres: DATABASE_URL=pglite://.pglite/dev
# In-memory tests: DATABASE_URL=pglite://memory
# Deployment: DATABASE_URL=postgresql://user:password@host/atlas?sslmode=require
# postgres:// is also accepted.

# Optional public repository link shown on Under the hood (not a secret).
NEXT_PUBLIC_REPO_URL=
